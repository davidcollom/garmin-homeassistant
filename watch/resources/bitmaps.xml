<?xml version="1.0" encoding="utf-8"?>
<!--
    Bitmap resources.

    The launcher icon is referenced from manifest.xml through
    @Drawables.LauncherIcon.  The resource compiler scales it to the icon
    size of the product, so a single 40 x 40 pixel image is enough for the
    round Venu 4 and for the rectangular Edge 1040.

    The icon itself is generated by watch/tools/make_launcher_icon.py so
    that the repository does not have to carry an unreviewable binary.
-->
<bitmaps>
    <bitmap id="LauncherIcon" filename="drawables/launcher_icon.png" />
</bitmaps>
