<?xml version="1.0"?>
<!--
    Garmin Home Assistant - Connect IQ watch application for the Venu 4.

    Licensed under the MIT licence, see LICENSE in the repository root.

    Product ids:
      venu441mm  - Venu 4, 41 mm
      venu445mm  - Venu 4, 45 mm

    The Edge 1040 is built from manifest-edge.xml, because that device does
    not implement Toybox.Notifications at all.

    minApiLevel is 6.0.0, the Connect IQ version of the Venu 4.  Every API
    used by this app exists in 6.0.0 or earlier:

      Toybox.Application.Properties  2.4.0
      Toybox.Application.Storage     2.4.0
      Toybox.Background               2.3.0
      Toybox.Communications           1.2.0
      Toybox.Graphics system fonts    1.3.0
      Toybox.Notifications            5.1.0
      Toybox.WatchUi.Button           2.1.0
      Toybox.WatchUi.TextArea         3.1.0
      Toybox.WatchUi.View             1.0.0

    See https://developer.garmin.com/connect-iq/articles/core-topics/Manifest_and_Permissions.html
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application
        id="03d13e1a-5c72-4b13-8e77-ebb94f9c4518"
        type="watch-app"
        name="@Strings.AppName"
        entry="MyApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="6.0.0">
        <iq:products>
            <iq:product id="venu441mm"/>
            <iq:product id="venu445mm"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Background"/>
            <iq:uses-permission id="Notifications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
